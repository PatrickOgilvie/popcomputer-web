{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "paths": {
      "@popcomputer/web": [
        "./src/index.ts"
      ],
      "@popcomputer/web/effect": [
        "./src/effect/index.ts"
      ],
      "@popcomputer/web/schema": [
        "./src/schema.ts"
      ],
      "@popcomputer/web/auth": [
        "./src/auth.ts"
      ],
      "@popcomputer/web/cache": [
        "./src/cache.ts"
      ],
      "@popcomputer/web/testing": [
        "./src/testing.ts"
      ],
      "@popcomputer/web/react": [
        "./src/react.ts"
      ],
      "@popcomputer/web/paths": [
        "./src/paths.ts"
      ],
      "@popcomputer/web/endpoint": [
        "./src/endpoint.ts"
      ],
      "@popcomputer/web/drizzle": [
        "./src/drizzle.ts"
      ]
    },
    "rootDir": "."
  },
  "include": [
    "src/**/*",
    "tests/setup-types.ts",
    "tests/testing.test.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
