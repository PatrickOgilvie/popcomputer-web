{
  "name": "@popcomputer/web",
  "version": "1.8.0",
  "description": "Effect-native server-driven web applications on Hono",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "import": "./dist/effect/index.js",
      "default": "./dist/effect/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js",
      "default": "./dist/paths.js"
    },
    "./endpoint": {
      "types": "./dist/endpoint.d.ts",
      "import": "./dist/endpoint.js",
      "default": "./dist/endpoint.js"
    },
    "./lint": {
      "types": "./dist/lint/index.d.ts",
      "import": "./dist/lint/index.js",
      "default": "./dist/lint/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js",
      "default": "./dist/drizzle.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "import": "./dist/cache.js",
      "default": "./dist/cache.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./fence": {
      "types": "./dist/fence/index.d.ts",
      "import": "./dist/fence/index.js",
      "default": "./dist/fence/index.js"
    },
    "./fuzz": {
      "types": "./dist/fuzz.d.ts",
      "import": "./dist/fuzz.js",
      "default": "./dist/fuzz.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    }
  },
  "bin": {
    "popweb-fence": "dist/fence/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "docs",
    "CHANGELOG.md",
    "UPGRADING.md",
    "skills",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "test": "bun run build && bun test && bun run test:types && bun run test:package",
    "test:package": "bun run build && node tests/package-imports.mjs",
    "test:types": "bun tests/typecheck-tests.ts && bun run build && bun tests/docs/check-docs.ts && tsc -p tests/consumer-types",
    "test:watch": "bun test --watch",
    "fuzz": "FUZZ_RUNS=${FUZZ_RUNS:-20000} FUZZ_SEED=${FUZZ_SEED:-random} bun test tests/fuzz",
    "test:coverage": "bun test --coverage",
    "prepublishOnly": "bun run test"
  },
  "keywords": [
    "hono",
    "inertia",
    "spa",
    "react",
    "cloudflare",
    "workers"
  ],
  "author": "Patrick Ogilvie",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrickogilvie/popcomputer-web.git"
  },
  "homepage": "https://github.com/patrickogilvie/popcomputer-web#readme",
  "bugs": {
    "url": "https://github.com/patrickogilvie/popcomputer-web/issues"
  },
  "overrides": {
    "undici": "^7.29.1",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "hono": "^4.13.5",
    "better-auth": ">=1.7.7 <1.8.0",
    "miniflare": ">=4.0.0 <5.0.0",
    "drizzle-orm": ">=0.45.2 <1.0.0",
    "@types/react": ">=18",
    "vite": ">=6.1.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "miniflare": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@electric-sql/pglite": "^0.5.10",
    "@inertiajs/core": "3.9.1",
    "@inertiajs/react": "3.9.1",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-auth": "1.7.10",
    "drizzle-orm": "^0.45.4",
    "effect": "4.0.5",
    "esbuild": "^0.28.2",
    "hono": "^4.13.13",
    "miniflare": "4.20260730.0",
    "oxlint": "1.82.0",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2",
    "vite": "^6.4.4"
  }
}
