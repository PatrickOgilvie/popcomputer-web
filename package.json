{
  "name": "honertia",
  "version": "0.2.1",
  "description": "Inertia.js-style server-driven SPA adapter for Hono",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "honertia": "dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "import": "./dist/effect/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "import": "./dist/cache.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "test": "bun test && bun run test:types && bun run test:package",
    "test:package": "bun run build && node dist/cli/bin.js routes --app tests/fixtures/cli-package-app.ts --json",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "hono",
    "inertia",
    "spa",
    "react",
    "cloudflare",
    "workers"
  ],
  "author": "Patrick Ogilvie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrickogilvie/honertia.git"
  },
  "dependencies": {
    "effect": "^3.12.0",
    "tsx": "^4.23.11"
  },
  "peerDependencies": {
    "hono": ">=4.0.0",
    "better-auth": ">=1.0.0 <2.0.0",
    "drizzle-orm": ">=0.30.0"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "better-auth": "1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
