{
  "name": "@popcomputer/web",
  "version": "0.8.0-next.1",
  "description": "Effect-native server-driven web applications on Hono",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "import": "./dist/effect/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "import": "./dist/cache.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "skills",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "test": "bun run build && bun test && bun run test:types && bun run test:package",
    "test:package": "bun run build && node tests/package-imports.mjs",
    "test:types": "bun tests/typecheck-tests.ts && bun run build && bun tests/docs/check-docs.ts && tsc -p tests/consumer-types",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "prepublishOnly": "bun run test"
  },
  "keywords": [
    "hono",
    "inertia",
    "spa",
    "react",
    "cloudflare",
    "workers"
  ],
  "author": "Patrick Ogilvie",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrickogilvie/popcomputer-web.git"
  },
  "homepage": "https://github.com/patrickogilvie/popcomputer-web#readme",
  "bugs": {
    "url": "https://github.com/patrickogilvie/popcomputer-web/issues"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "hono": "^4.10.0",
    "better-auth": ">=1.0.0 <2.0.0",
    "drizzle-orm": ">=0.30.0 <1.0.0",
    "@types/react": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@electric-sql/pglite": "^0.5.9",
    "@inertiajs/core": "3.9.1",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.4",
    "effect": "4.0.3",
    "esbuild": "^0.28.2",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2"
  }
}
